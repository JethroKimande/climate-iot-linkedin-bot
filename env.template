# Environment Variables Template
# Copy this file to .env and fill in your REAL credentials
# NEVER commit the .env file to git!

# LinkedIn API Configuration (REPLACE WITH YOUR REAL VALUES)
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_access_token_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/callback

# Auto-posting configuration
AUTO_POST_LINKEDIN=false

# Caeli API Configuration
CAELI_API_KEY=your_caeli_api_key_here

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=INFO
